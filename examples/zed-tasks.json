[
  {
    "label": "Preview current GLB/glTF",
    "command": "node",
    "args": [
      "<absolute-path-to-this-repo>/viewer/scripts/dev-server.mjs",
      "--root",
      "$ZED_WORKTREE_ROOT",
      "--model",
      "$ZED_RELATIVE_FILE",
      "--open"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Browse GLB/glTF models",
    "command": "node",
    "args": [
      "<absolute-path-to-this-repo>/viewer/scripts/dev-server.mjs",
      "--root",
      "$ZED_WORKTREE_ROOT",
      "--open"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]

